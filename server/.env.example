# ==============================================================================
# NagarWatch Server - Environment Configuration
# ==============================================================================

# Server
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/nagarwatch

# Redis (Upstash REST API for caching)
REDIS_URL=https://your-upstash-redis-url.upstash.io
REDIS_TOKEN=your_upstash_redis_token

# Redis TCP (ioredis for BullMQ SLA background queues)
REDIS_TCP_URL=rediss://default:your_token@your-upstash-redis-endpoint:6379

# Authentication (Clerk)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_JWT_KEY=your_clerk_jwt_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret

# AI & Multilingual Services
GEMINI_API_KEY=your_google_gemini_api_key
SARVAM_API_KEY=your_sarvam_ai_api_key

# Government Datasets API Endpoints
CPWD_DATA_API=https://opendata.best/api/v1/in_cpwd_enlisted_contractors
CPWD_DEBARRED_API=https://opendata.best/api/v1/in_cpwd_debarred_contractors

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Dispatcher (Resend / SMTP)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=notifications@nagarwatch.org
