# ==============================================================================
# NagarWatch - Unified Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Express Backend Server
# ------------------------------------------------------------------------------
# Port on which the Express server listens (default: 3001)
PORT=3001

# Application environment mode (development | test | production)
NODE_ENV=development

# Web origin of the Next.js frontend for CORS headers and email notification links
CLIENT_URL=http://localhost:3000

# Alternative frontend origin accepted by CORS and Socket.IO
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (use local mongod instance or get connection string from MongoDB Atlas: https://cloud.mongodb.com)
MONGODB_URI=mongodb://localhost:27017/nagarwatch

# ------------------------------------------------------------------------------
# 3. Redis Cache & BullMQ Message Queue
# ------------------------------------------------------------------------------
# Upstash Redis REST API URL for HTTP cache clients (from Upstash Console -> Redis Database Details: https://console.upstash.com)
REDIS_URL=https://your-upstash-redis-url.upstash.io

# Upstash Redis REST API bearer token for authentication (from Upstash Console -> Redis Database Details)
REDIS_TOKEN=your_upstash_redis_token

# Direct Redis TCP URI for BullMQ SLA background worker queue (local: redis://localhost:6379, or rediss:// from Upstash)
REDIS_TCP_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. Authentication & Authorization (Clerk)
# ------------------------------------------------------------------------------
# Clerk backend secret API key used for user verification (get from Clerk Dashboard -> API Keys: https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_yourClerkSecretKeyHere

# Clerk public publishable key for backend client initialization (get from Clerk Dashboard -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_yourClerkPublishableKeyHere

# Clerk PEM-encoded RSA public JWT key for offline token verification (get from Clerk Dashboard -> API Keys -> Advanced)
CLERK_JWT_KEY=your_clerk_jwt_key_here

# Clerk Svix webhook signing secret for user lifecycle events (get from Clerk Dashboard -> Webhooks -> Endpoint Secret)
CLERK_WEBHOOK_SECRET=whsec_yourWebhookSecretHere

# ------------------------------------------------------------------------------
# 5. Artificial Intelligence & Language Services
# ------------------------------------------------------------------------------
# Google Gemini API key for AI grievance categorization and priority scoring (get from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Gemini model identifier used for inference (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Sarvam AI API key for Indic audio transcription and multilingual translation (get from Sarvam AI Dashboard: https://sarvam.ai)
SARVAM_API_KEY=your_sarvam_ai_api_key_here

# ------------------------------------------------------------------------------
# 6. Media Storage (Cloudinary)
# ------------------------------------------------------------------------------
# Cloudinary account cloud name for citizen complaint photo uploads (get from Cloudinary Console Dashboard: https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary account API key (get from Cloudinary Console -> Settings -> Access Keys)
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary account API secret (get from Cloudinary Console -> Settings -> Access Keys)
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 7. Email Notifications & Municipal Alerts (Resend)
# ------------------------------------------------------------------------------
# Resend API key for transactional emails and SLA escalation alerts (get from Resend Dashboard -> API Keys: https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email address verified in your Resend account (configured in Resend -> Domains)
EMAIL_FROM=notifications@nagarwatch.org

# Fallback administrator email address receiving SLA warning notices
EMAIL_USER=admin@nagarwatch.org

# Municipal commissioner email address for weekly automated grievance digest reports
COMMISSIONER_EMAIL=commissioner@nagarwatch.org

# ------------------------------------------------------------------------------
# 8. Civic & Government Open Data APIs
# ------------------------------------------------------------------------------
# REST API endpoint for CPWD enlisted contractors directory (default public open data endpoint)
CPWD_DATA_API=https://opendata.best/api/v1/in_cpwd_enlisted_contractors

# REST API endpoint for CPWD debarred/blacklisted contractors directory
CPWD_DEBARRED_API=https://opendata.best/api/v1/in_cpwd_debarred_contractors

# ------------------------------------------------------------------------------
# 9. Next.js Frontend Configuration
# ------------------------------------------------------------------------------
# Base URL for the Express backend API accessed by the browser and SSR (e.g., http://localhost:3001/api)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Public URL for the Socket.IO real-time grievance notification server (e.g., http://localhost:3001)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Clerk frontend publishable key exposed to Next.js (get from Clerk Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_yourClerkPublishableKeyHere

# Route path for the frontend user sign-in page
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Route path for the frontend user sign-up page
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Default post-authentication redirection route for logged-in users
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/citizen/dashboard

# Default post-registration redirection route for newly registered users
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/citizen/dashboard

# what3words API key for 3-word geolocation address resolution (get from what3words Developer Portal: https://developer.what3words.com)
NEXT_PUBLIC_W3W_API_KEY=your_what3words_api_key

# Alternative what3words environment key alias supported by client
NEXT_PUBLIC_WHAT3WORDS_API_KEY=your_what3words_api_key

# Mappls (MapmyIndia) API key for Indian street-level civic mapping (get from Mappls Console: https://about.mappls.com/api)
NEXT_PUBLIC_MAPPLS_KEY=your_mappls_api_key
